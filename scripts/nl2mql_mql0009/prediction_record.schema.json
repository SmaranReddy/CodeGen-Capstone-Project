{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "MQL-0009 prediction record (one line of predictions/<arm_run>/predictions.jsonl)",
 "type": "object",
 "required": ["prediction_id", "experiment", "arm", "arm_family", "random_seed", "id", "db_id", "raw_text", "normalized_mql",
              "parse_status", "status", "generation_failure", "error", "retrieval", "prompt_sha256", "model_id", "model_revision",
              "precision", "generation_config", "runtime", "config_sha256", "fingerprint", "input_tokens", "output_tokens"],
 "properties": {
  "prediction_id": {"type": "string", "description": "stable id 'MQL-0009:<arm_run>:<eval id>'"},
  "experiment": {"const": "MQL-0009"},
  "arm": {"enum": ["A_zero_shot", "B_random_s1", "B_random_s2", "B_random_s3", "B_random_s4", "B_random_s5", "C_fixed", "D_hybrid"]},
  "arm_family": {"enum": ["zero_shot", "random", "fixed", "hybrid"]},
  "random_seed": {"type": ["integer", "null"]},
  "id": {"type": "string", "pattern": "^spider_train_[0-9]{5}$"},
  "db_id": {"type": "string"},
  "raw_text": {"type": ["string", "null"], "description": "raw generated response (the only input the Windows evaluator scores)"},
  "normalized_mql": {"type": ["object", "null"], "description": "informational parse; NOT a safety-validated query"},
  "parse_status": {"enum": ["parsed", "parsed_bad_shape", "unparseable", "generation_failure"]},
  "status": {"enum": ["ok", "error"]},
  "generation_failure": {"type": "boolean"},
  "error": {"type": ["string", "null"]},
  "retrieval": {"type": "object", "required": ["strategy", "retrieved_ids", "context_tokens", "empty_context"]},
  "prompt_sha256": {"type": "string"},
  "model_id": {"const": "Qwen/Qwen2.5-Coder-3B-Instruct"},
  "model_revision": {"const": "488639f1ff808d1d3d0ba301aef8c11461451ec5"},
  "precision": {"type": "object", "required": ["dtype", "bf16_native", "gpu", "compute_capability"]},
  "generation_config": {"type": "object", "required": ["dtype", "do_sample", "max_new_tokens", "batch_size", "seed"]},
  "runtime": {"type": "object", "required": ["gpu", "compute_capability", "bf16_native", "torch", "transformers"]},
  "config_sha256": {"type": "string"},
  "fingerprint": {"type": "string"},
  "input_tokens": {"type": ["integer", "null"]},
  "output_tokens": {"type": ["integer", "null"]}
 },
 "not": {"anyOf": [{"required": ["sql"]}, {"required": ["gold_sql"]}, {"required": ["gold_mql"]}, {"required": ["expected_output"]},
                   {"required": ["outcome"]}, {"required": ["correct"]}, {"required": ["gold_rows"]}]}
}
